{
  "permissions": {
    "deny": [
    ],
    "ask": [
      "Bash(pip install*)",
      "Bash(uv add*)",
      "WebFetch",
      "WebSearch"
    ],
    "allow": [
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make fixtures*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Read(./reports/agregados/**)"
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
