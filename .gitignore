# Datos reales y bases bloqueadas — nunca se versionan
data/raw/*
!data/raw/README.md
data/private/
*.duckdb
*.duckdb.wal
.env

# Modelos preentrenados (pesos binarios; solo se versiona MANIFEST.json)
models/*
!models/README.md
!models/MANIFEST.json

# Dependencias fuera de línea (se regeneran con scripts/preparar_wheelhouse.sh)
wheelhouse/

# Salidas (solo reports/agregados/ se versiona, y de forma selectiva)
reports/*
!reports/agregados/
reports/agregados/*
!reports/agregados/.gitkeep
!reports/agregados/README.md

# Entornos y cachés de Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Sistema
.DS_Store

# Fixtures sintéticos grandes (se regeneran con make fixtures; se versiona solo el generador)
# Nota: si el equipo decide versionar fixtures pequeños, quitar esta línea.

# Vectores de embeddings (se regeneran con make nlp; grandes, no se versionan)
data/embeddings/*
!data/embeddings/README.md

# Taxonomía borrador: salida de `make fenomenos` sobre datos reales (medoides/bordes de texto
# enmascarado, derivados de relatos reales). Nunca se versiona; solo v1.0.yaml (curada por
# analistas en el taller, con ejemplos sintéticos o ids, no excertos reales) se comitea.
config/taxonomia/v0.1-borrador.yaml
